{
  "schema": "guard.command-extension-fixtures.v1",
  "extension_id": "command.shieldenv",
  "build": {
    "base": "packaged",
    "schema": "guard.command-extension-build.v1",
    "sources": [
      {
        "schema": "guard.command-extension-source.v1",
        "name": "shieldenv",
        "version": "1.0.0",
        "license": "MIT",
        "source": "built-in",
        "required": false,
        "risk_classes": ["low"],
        "permissions": {
          "default_enabled": true,
          "network": false,
          "filesystem": "read-only"
        },
        "rules": [
          {
            "id": "shieldenv_scan",
            "matcher": {
              "leading-subcommand.v1": {
                "executables": ["shieldenv", "shieldenv.exe", "shieldenv.cmd"],
                "subcommand": "scan"
              }
            },
            "action": "allow"
          }
        ],
        "extension": {
          "extension_id": "command.shieldenv",
          "description": "Provides fast, local-first secret scanning and pre-commit checks via ShieldEnv without modifying core repository configurations.",
          "homepage": "https://github.com/ShieldRunner-NET/shieldenv",
          "executables": [
            "shieldenv"
          ],
          "action_classes": [
            "local_secret_scan"
          ],
          "aliases": [],
          "conflicts": [],
          "dependencies": [],
          "ecosystem_ids": [],
          "delegated_protection": null,
          "icon": {
            "kind": "none"
          },
          "publisher": {
            "display_name": "Community",
            "id": "community.shieldrunner-net",
            "url": "https://github.com/ShieldRunner-NET/shieldenv"
          }
        },
        "project_markers": [],
        "safer_alternatives": []
      }
    ]
  },
  "cases": [
    {
      "id": "shieldenv_scan_matching",
      "rule_id": "shieldenv_scan",
      "command": "shieldenv scan --path contributions/",
      "expected_action": "allow",
      "enabled_extensions": ["command.shieldenv"],
      "disabled_permissions": [],
      "expected_effective_segments": []
    },
    {
      "id": "shieldenv_unrelated_command",
      "rule_id": "shieldenv_scan",
      "command": "echo hello",
      "expected_action": "allow",
      "enabled_extensions": ["command.shieldenv"],
      "disabled_permissions": [],
      "expected_effective_segments": []
    }
  ]
}