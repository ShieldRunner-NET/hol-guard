{
  "schema": "guard.command-extension-fixtures.v1",
  "build": {
    "base": "packaged",
    "schema": "guard.command-extension-build.v1",
    "sources": [
      {
        "schema": "guard.command-extension-source.v1",
        "path": "contributions/command-sources/command.shieldenv.json"
      }
    ]
  },
  "trust": {
    "schemaVersion": "guard.extension-trust-class-map.v1",
    "publishers": {
      "hol": {
        "displayName": "Hashgraph Online",
        "id": "hol"
      },
      "hol-curated": {
        "displayName": "HOL curated library",
        "id": "hol-curated"
      }
    },
    "classes": {
      "external": [
        "command.apex",
        "command.drip",
        "command.shieldenv",
        "command.ollama"
      ],
      "first-party": [
        "command.container-runtime",
        "command.filesystem",
        "command.git",
        "command.system"
      ],
      "trusted-library": [
        "command.github",
        "command.remote.ssh"
      ]
    }
  },
  "cases": [
    {
      "id": "shieldenv_scan_matching",
      "rule_id": "command.shieldenv.scan",
      "command": "shieldenv scan --path contributions/",
      "expected_action": "review",
      "enabled_extensions": ["command.shieldenv"],
      "disabled_permissions": [],
      "expected_effective_segments": [0]
    },
    {
      "id": "shieldenv_unrelated_command",
      "rule_id": "command.shieldenv.scan",
      "command": "echo hello",
      "expected_action": "allow",
      "enabled_extensions": ["command.shieldenv"],
      "disabled_permissions": [],
      "expected_effective_segments": []
    }
  ]
}